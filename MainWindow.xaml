<tsd:PluginWindowBase
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tsd="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
        xmlns:UIControls="clr-namespace:Tekla.Structures.Dialog.UIControls;assembly=Tekla.Structures.Dialog"
        xmlns:localUI="clr-namespace:RAM.Plugins.ColumnJointGP1.UIControls"
        x:Class="RAM.Plugins.ColumnJointGP1.MainWindow"
        Title="RAM ColumnJointGP1 (Альфа)" FontSize="14" Height="650" Width="1050">
    <Grid>
        <Grid.Resources>
            <Style TargetType="TextBox">
                <Setter Property="Height" Value="24"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Margin" Value="2"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Height" Value="24"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Margin" Value="2"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Margin" Value="2"/>
            </Style>
            <Style TargetType="UIControls:WpfFilterCheckBox">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="5,0"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <localUI:HeaderSystemControl Grid.Row="0" Margin="0,5,0,5"/>

        <TabControl Grid.Row="1" Margin="5">
            <!-- ПЕРВАЯ ВКЛАДКА -->
            <TabItem Header="Настройки узла">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="25"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="Позиционирование и зазоры" FontWeight="Bold" Margin="0,5,0,5"/>

                        <UIControls:WpfFilterCheckBox Grid.Row="1" Grid.Column="0" AttributeName="Offset_Web_Mode"/>
                        <Label Grid.Row="1" Grid.Column="1" Content="Режим подрезки (колонна):"/>
                        <ComboBox Grid.Row="1" Grid.Column="2" SelectedIndex="{Binding Offset_Web_Mode}">
                            <ComboBoxItem Content="От плоскости стенки"/>
                            <ComboBoxItem Content="От внешнего габарита"/>
                        </ComboBox>

                        <UIControls:WpfFilterCheckBox Grid.Row="2" Grid.Column="0" AttributeName="Offset_Web"/>
                        <Label Grid.Row="2" Grid.Column="1" Content="Зазор до колонны:"/>
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Offset_Web}"/>

                        <UIControls:WpfFilterCheckBox Grid.Row="3" Grid.Column="0" AttributeName="Offset_Gusset"/>
                        <Label Grid.Row="3" Grid.Column="1" Content="Смещение фасонки:"/>
                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Offset_Gusset}"/>

                        <UIControls:WpfFilterCheckBox Grid.Row="4" Grid.Column="0" AttributeName="Offset_Brace"/>
                        <Label Grid.Row="4" Grid.Column="1" Content="Зазор до раскосов:"/>
                        <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding Offset_Brace}"/>

                        <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="Углы фасонки (Пусто = 90 град.)" FontWeight="Bold" Margin="0,15,0,5"/>

                        <UIControls:WpfFilterCheckBox Grid.Row="6" Grid.Column="0" AttributeName="Angle_Top"/>
                        <Label Grid.Row="6" Grid.Column="1" Content="Угол верхнего реза:"/>
                        <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding Angle_Top}"/>

                        <UIControls:WpfFilterCheckBox Grid.Row="7" Grid.Column="0" AttributeName="Straight_Top"/>
                        <Label Grid.Row="7" Grid.Column="1" Content="Прямой участок (Верх):"/>
                        <TextBox Grid.Row="7" Grid.Column="2" Text="{Binding Straight_Top}"/>

                        <UIControls:WpfFilterCheckBox Grid.Row="8" Grid.Column="0" AttributeName="Angle_Bot"/>
                        <Label Grid.Row="8" Grid.Column="1" Content="Угол нижнего реза:"/>
                        <TextBox Grid.Row="8" Grid.Column="2" Text="{Binding Angle_Bot}"/>

                        <UIControls:WpfFilterCheckBox Grid.Row="9" Grid.Column="0" AttributeName="Straight_Bot"/>
                        <Label Grid.Row="9" Grid.Column="1" Content="Прямой участок (Низ):"/>
                        <TextBox Grid.Row="9" Grid.Column="2" Text="{Binding Straight_Bot}"/>

                        <TextBlock Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Text="Атрибуты фасонки" FontWeight="Bold" Margin="0,15,0,5"/>
                        <UIControls:WpfFilterCheckBox Grid.Row="11" Grid.Column="0" AttributeName="GP_Thickness"/>
                        <Label Grid.Row="11" Grid.Column="1" Content="Толщина / Класс:"/>
                        <StackPanel Grid.Row="11" Grid.Column="2" Orientation="Horizontal">
                            <TextBox Width="50" Text="{Binding GP_Thickness}"/>
                            <UIControls:WpfFilterCheckBox AttributeName="GP_Class" Margin="10,0,5,0"/>
                            <TextBox Width="50" Text="{Binding GP_Class}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ВТОРАЯ ВКЛАДКА -->
            <TabItem Header="Типы раскосов">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="120"/>
                            <!-- Под эскиз -->
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Плейсхолдер для эскиза -->
                        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Background="#F0F0F0" Margin="0,0,0,15">
                            <TextBlock Text="[ МЕСТО ДЛЯ ЭСКИЗА ПАРАМЕТРОВ РАСКОСА ]" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                        </Border>

                        <!-- Таблица -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Заголовки -->
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Класс" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Шов (h)" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Отступ (e1)" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Отступ (e2)" FontWeight="Bold" HorizontalAlignment="Center"/>

                            <!-- Строка 1 -->
                            <UIControls:WpfFilterCheckBox Grid.Row="1" Grid.Column="0" AttributeName="B1_Class"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding B1_Class}"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding B1_h}"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding B1_e1}"/>
                            <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding B1_e2}"/>

                            <!-- Строка 2 -->
                            <UIControls:WpfFilterCheckBox Grid.Row="2" Grid.Column="0" AttributeName="B2_Class"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding B2_Class}"/>
                            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding B2_h}"/>
                            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding B2_e1}"/>
                            <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding B2_e2}"/>

                            <!-- Строка 3 -->
                            <UIControls:WpfFilterCheckBox Grid.Row="3" Grid.Column="0" AttributeName="B3_Class"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding B3_Class}"/>
                            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding B3_h}"/>
                            <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding B3_e1}"/>
                            <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding B3_e2}"/>

                            <!-- Строка 4 -->
                            <UIControls:WpfFilterCheckBox Grid.Row="4" Grid.Column="0" AttributeName="B4_Class"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding B4_Class}"/>
                            <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding B4_h}"/>
                            <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding B4_e1}"/>
                            <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding B4_e2}"/>

                            <!-- Строка 5 -->
                            <UIControls:WpfFilterCheckBox Grid.Row="5" Grid.Column="0" AttributeName="B5_Class"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding B5_Class}"/>
                            <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding B5_h}"/>
                            <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding B5_e1}"/>
                            <TextBox Grid.Row="5" Grid.Column="4" Text="{Binding B5_e2}"/>
                        </Grid>

                        <TextBlock Grid.Row="2" Text="Специальные классы (через пробел)" FontWeight="Bold" Margin="0,20,0,5"/>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="25"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <UIControls:WpfFilterCheckBox Grid.Row="0" Grid.Column="0" AttributeName="Class_Exclude"/>
                            <Label Grid.Row="0" Grid.Column="1" Content="Исключаемые:"/>
                            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Class_Exclude}"/>

                            <UIControls:WpfFilterCheckBox Grid.Row="1" Grid.Column="0" AttributeName="Class_Splice"/>
                            <Label Grid.Row="1" Grid.Column="1" Content="Стыковые:"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Class_Splice}"/>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <UIControls:WpfOkApplyModifyGetOnOffCancel Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,5,0,5"
            ApplyClicked="WpfOkApplyModifyGetOnOffCancel_ApplyClicked" 
            CancelClicked="WpfOkApplyModifyGetOnOffCancel_CancelClicked" 
            GetClicked="WpfOkApplyModifyGetOnOffCancel_GetClicked" 
            ModifyClicked="WpfOkApplyModifyGetOnOffCancel_ModifyClicked" 
            OkClicked="WpfOkApplyModifyGetOnOffCancel_OkClicked" 
            OnOffClicked="WpfOkApplyModifyGetOnOffCancel_OnOffClicked"/>
    </Grid>
</tsd:PluginWindowBase>