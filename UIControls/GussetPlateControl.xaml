<UserControl x:Class="RAM.Plugins.ColumnJointGP1.UIControls.GussetPlateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:UIControls="clr-namespace:Tekla.Structures.Dialog.UIControls;assembly=Tekla.Structures.Dialog"
             xmlns:localConv="clr-namespace:RAM.Plugins.ColumnJointGP1.Converters">

    <!-- Регистрация конвертера цветов -->
    <UserControl.Resources>
        <localConv:ClassToColorConverter x:Key="ClassToColorConverter" />
    </UserControl.Resources>

    <GroupBox Header="Свойства фасонки" Padding="15">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- МАСТЕР-ГАЛОЧКА -->
            <UIControls:WpfFilterCheckBox x:Name="chk_GP_Thickness_Master" 
                                          AttributeName="GP_Thickness" 
                                          Click="MasterCheckbox_Click" 
                                          VerticalAlignment="Center" Margin="0,0,10,0"/>

            <!-- КНОПКА-ПЛАШКА -->
            <Button Width="110" Height="55" Click="BtnOpenOverlay_Click" Background="#EFEFEF" BorderBrush="#B0B0B0" BorderThickness="1" Cursor="Hand">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Цвет класса -->
                        <Border Width="14" Height="14" Margin="0,0,5,0"
                                Background="{Binding GP_Class, Converter={StaticResource ClassToColorConverter}}"
                                BorderBrush="#555555" BorderThickness="1" VerticalAlignment="Center"/>

                        <TextBlock Text="{Binding GP_Thickness, StringFormat='PL{0}'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding GP_Material}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </GroupBox>
</UserControl>