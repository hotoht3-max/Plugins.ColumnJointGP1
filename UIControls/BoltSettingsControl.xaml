<UserControl x:Class="RAM.Plugins.ColumnJointGP1.UIControls.BoltSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tsd="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
             xmlns:UIControls="clr-namespace:Tekla.Structures.Dialog.UIControls;assembly=Tekla.Structures.Dialog"
             xmlns:local="clr-namespace:RAM.Plugins.ColumnJointGP1.UIControls">

    <!-- Регистрируем наш конвертер -->
    <UserControl.Resources>
        <local:IntToBoolConverter x:Key="IntToBool"/>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="300"/>
            <!-- Левая часть с параметрами -->
            <ColumnDefinition Width="Auto"/>
            <!-- Правая часть с векторной маской -->
        </Grid.ColumnDefinitions>

        <!-- ================= ЛЕВАЯ ЧАСТЬ (ПАРАМЕТРЫ) ================= -->
        <Grid Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="25"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Диаметр -->
            <UIControls:WpfFilterCheckBox Grid.Row="0" Grid.Column="0" AttributeName="SpliceBolt_Size" Margin="5"/>
            <Label Grid.Row="0" Grid.Column="1" Content="Диаметр:" Margin="2"/>
            <ComboBox Grid.Row="0" Grid.Column="2" 
                      ItemsSource="{Binding AvailableSizes}" 
                      Text="{Binding SpliceBolt_Size}" 
                      IsEditable="True" Margin="2"/>

            <!-- Стандарт -->
            <UIControls:WpfFilterCheckBox Grid.Row="1" Grid.Column="0" AttributeName="SpliceBolt_Standard" Margin="5"/>
            <Label Grid.Row="1" Grid.Column="1" Content="Стандарт болта:" Margin="2"/>
            <ComboBox Grid.Row="1" Grid.Column="2" 
                      ItemsSource="{Binding AvailableStandards}" 
                      Text="{Binding SpliceBolt_Standard}" 
                      IsEditable="True" Margin="2"/>

            <!-- Допуск -->
            <UIControls:WpfFilterCheckBox Grid.Row="2" Grid.Column="0" AttributeName="SpliceBolt_Tol" Margin="5"/>
            <Label Grid.Row="2" Grid.Column="1" Content="Допуск:" Margin="2"/>
            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding SpliceBolt_Tol}" Margin="2"/>
        </Grid>

        <!-- ================= ПРАВАЯ ЧАСТЬ (ВЕКТОРНАЯ МАСКА) ================= -->
        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top" Margin="10,0,0,0">
            <Canvas Width="200" Height="140" Background="Transparent" Margin="0,0,0,10">
                <Rectangle Canvas.Left="36" Canvas.Top="15" Width="6" Height="70" Fill="#FFD166" Stroke="Black" StrokeThickness="1"/>
                <Rectangle Canvas.Left="44" Canvas.Top="5" Width="14" Height="90" Fill="#60A0D0" Stroke="Black" StrokeThickness="1"/>
                <Rectangle Canvas.Left="60" Canvas.Top="5" Width="14" Height="90" Fill="#60A0D0" Stroke="Black" StrokeThickness="1"/>
                <Rectangle Canvas.Left="76" Canvas.Top="5" Width="14" Height="90" Fill="#60A0D0" Stroke="Black" StrokeThickness="1"/>
                <Rectangle Canvas.Left="92" Canvas.Top="15" Width="6" Height="70" Fill="#FFD166" Stroke="Black" StrokeThickness="1"/>
                <Rectangle Canvas.Left="100" Canvas.Top="15" Width="6" Height="70" Fill="#FFD166" Stroke="Black" StrokeThickness="1"/>
                <Rectangle Canvas.Left="108" Canvas.Top="25" Width="14" Height="50" Fill="#FFD166" Stroke="Black" StrokeThickness="1"/>
                <Rectangle Canvas.Left="124" Canvas.Top="25" Width="14" Height="50" Fill="#FFD166" Stroke="Black" StrokeThickness="1"/>
                <Polygon Points="20,25 34,25 34,41 150,41 150,59 34,59 34,75 20,75" Fill="#C0C0C0" Stroke="Black" StrokeThickness="1"/>
                <Line X1="5" Y1="50" X2="175" Y2="50" Stroke="Gray" StrokeThickness="1" StrokeDashArray="4,4"/>
                <Line X1="39" Y1="85" X2="39" Y2="105" Stroke="Black" StrokeThickness="1"/>
                <Line X1="95" Y1="85" X2="95" Y2="120" Stroke="Black" StrokeThickness="1"/>
                <Line X1="103" Y1="85" X2="103" Y2="105" Stroke="Black" StrokeThickness="1"/>
                <Line X1="115" Y1="75" X2="125" Y2="105" Stroke="Black" StrokeThickness="1"/>
                <Line X1="131" Y1="75" X2="150" Y2="105" Stroke="Black" StrokeThickness="1"/>
                <Line X1="150" Y1="50" X2="165" Y2="50" Stroke="Black" StrokeThickness="1"/>

                <!-- ЧЕКБОКСЫ (Теперь с подключенным конвертером) -->
                <CheckBox IsChecked="{Binding SpliceBolt_W1, Converter={StaticResource IntToBool}}" Canvas.Left="32" Canvas.Top="105"/>
                <CheckBox IsChecked="{Binding SpliceBolt_W2, Converter={StaticResource IntToBool}}" Canvas.Left="88" Canvas.Top="120"/>
                <CheckBox IsChecked="{Binding SpliceBolt_W3, Converter={StaticResource IntToBool}}" Canvas.Left="96" Canvas.Top="105"/>
                <CheckBox IsChecked="{Binding SpliceBolt_N1, Converter={StaticResource IntToBool}}" Canvas.Left="118" Canvas.Top="105"/>
                <CheckBox IsChecked="{Binding SpliceBolt_N2, Converter={StaticResource IntToBool}}" Canvas.Left="143" Canvas.Top="105"/>
                <CheckBox IsChecked="{Binding SpliceBolt_Bolt, Converter={StaticResource IntToBool}}" Canvas.Left="168" Canvas.Top="43"/>
            </Canvas>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <UIControls:WpfFilterCheckBox VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Label Content="Использовать при изменении" VerticalAlignment="Center" Padding="0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>